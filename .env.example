DATABASE_URL=sqlite:///./terra_natura.db
SECRET_KEY=cambiar-en-produccion
DEBUG=true
# Opcional: Meta WhatsApp Cloud API — verificación del webhook (mismo valor que en Meta Developer)
WHATSAPP_VERIFY_TOKEN=
# Opcional: Meta Instagram webhook (si queda vacío, usa WHATSAPP_VERIFY_TOKEN)
INSTAGRAM_VERIFY_TOKEN=

# YouTube Data API v3 — recolectar videos turismo (ver docs/YOUTUBE_API_SETUP.md)
YOUTUBE_API_KEY=

# --- Video IA (free tier / opcional) — ver GET /api/ama/video/ia/conectores ---
# EE.UU.
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
# Video Pro Creator — Veo 3.1 (pip install google-genai)
VEO_MODEL=veo-3.1-generate-preview
RUNWAY_API_KEY=
LUMA_API_KEY=
PIKA_API_KEY=
INVIDEO_API_KEY=
HEYGEN_API_KEY=
PEXELS_API_KEY=

# China
KLING_API_KEY=
HAILUO_API_KEY=
MINIMAX_API_KEY=

# Europa
STABILITY_API_KEY=
PIXABAY_API_KEY=

# Meta — publicación Instagram (cuenta Business vinculada a la página)
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
